---
import { dojo, hero } from '../copy';
---

<section class="section dojo" id="dojo" aria-labelledby="dojo-title">
  <div class="wrap dojo-in">
    <div class="sign" aria-hidden="true">
      <span class="sign-k" lang="ja">{hero.kanji}</span>
      <span class="sign-cap hud">{hero.equation.note}</span>
    </div>
    <div>
      <header class="section-head" data-reveal>
        <p class="eyebrow hud">{dojo.eyebrow}</p>
        <h2 class="display" id="dojo-title">{dojo.title}</h2>
      </header>
      <ol class="rules">
        {
          dojo.rules.map((rule, i) => (
            <li data-reveal style={`--delay:${i * 80}ms`}>
              <span class="rule-n" lang="ja">
                {rule.n}
              </span>
              <div>
                <h3>{rule.title}</h3>
                <p>{rule.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .dojo {
    overflow: clip;
  }
  .dojo-in {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  @media (max-width: 960px) {
    .dojo-in {
      grid-template-columns: 1fr;
    }
  }
  .sign {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 3rem) 1rem;
    border: 2px solid rgb(255 43 214 / 0.35);
    border-radius: 2rem;
    background:
      radial-gradient(closest-side, rgb(255 43 214 / 0.14), transparent),
      rgb(255 255 255 / 0.01);
    box-shadow:
      inset 0 0 60px rgb(255 43 214 / 0.08),
      0 0 50px -20px var(--mag);
  }
  .sign::before,
  .sign::after {
    content: '';
    position: absolute;
    top: -2.5rem;
    width: 2px;
    height: 2.5rem;
    background: linear-gradient(transparent, #3a3160);
  }
  .sign::before {
    left: 25%;
  }
  .sign::after {
    right: 25%;
  }
  .sign-k {
    font: 900 clamp(12rem, 30vw, 24rem) / 1 var(--f-kanji);
    color: rgb(255 43 214 / 0.1);
    -webkit-text-stroke: 5px #ffd6f7;
    paint-order: stroke fill;
    filter: drop-shadow(0 0 3px #ff7ae6) drop-shadow(0 0 14px var(--mag)) drop-shadow(0 0 40px rgb(255 43 214 / 0.7));
  }
  @media (prefers-reduced-motion: no-preference) {
    .sign-k {
      animation: buzz 6s linear infinite;
    }
  }
  @keyframes buzz {
    0%,
    41%,
    43%,
    45%,
    100% {
      opacity: 1;
    }
    42%,
    44% {
      opacity: 0.55;
    }
  }
  .sign-cap {
    color: var(--cyan-hi);
    text-shadow: 0 0 10px var(--cyan);
    letter-spacing: 0.4em;
  }
  .rules {
    display: grid;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rules li {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    gap: 1.2rem;
    align-items: start;
  }
  .rule-n {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    font: 700 1.7rem/1 var(--f-brush);
    color: var(--amber-hi);
    border: 1.5px solid rgb(255 182 39 / 0.45);
    border-radius: 0.8rem;
    text-shadow: 0 0 14px var(--amber);
    box-shadow: inset 0 0 18px rgb(255 182 39 / 0.12);
  }
  .rules h3 {
    font: 800 1.3rem/1.25 var(--f-display);
  }
  .rules p {
    margin-top: 0.3rem;
    color: var(--muted);
  }
</style>
