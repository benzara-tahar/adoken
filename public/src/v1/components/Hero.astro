---
import { hero, x } from '../copy';
import HeroCabinet from './HeroCabinet.astro';
import LaunchForm from './LaunchForm.astro';
---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true">
    <span class="hero-kanji">{hero.kanji}</span>
    <div class="hero-floor"></div>
  </div>

  <div class="wrap hero-in">
    <div class="hero-copy">
      <p class="hero-hud hud">
        {hero.hud.map((item, i) => <span class:list={{ p1: i === 0 }}>{item}</span>)}
      </p>
      <h1 class="display">
        <span>{hero.titleTop}</span>
        <span class="grad-text">{hero.titleBottom}</span>
      </h1>
      <p class="hero-eq">
        <b>{hero.equation.left}</b><span aria-hidden="true">+</span><b class="kanji" lang="ja">{hero.equation.right}</b><span
          aria-hidden="true">=</span
        ><b class="name">ado<em>ken</em></b>
        <small>{hero.equation.note}</small>
      </p>
      <p class="hero-lede">{hero.lede}</p>
      <LaunchForm placement="v1-hero" />
      <a class="hero-follow" href={x.url} rel="me" data-track="follow_x_clicked" data-placement="v1-hero">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
          ><path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          ></path></svg
        >
        {hero.follow} <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="hero-stage">
      <HeroCabinet />
      <ul class="hero-chips hud" aria-label="Highlights">
        {hero.chips.map((chip) => <li>{chip}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 7rem);
    overflow: clip;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero-kanji {
    position: absolute;
    top: -6%;
    right: -6%;
    font: 900 min(54rem, 62vw) / 1 var(--f-kanji);
    color: transparent;
    -webkit-text-stroke: 2px rgb(255 140 235 / 0.75);
    filter: drop-shadow(0 0 6px rgb(255 43 214 / 0.9)) drop-shadow(0 0 30px rgb(255 43 214 / 0.55));
    opacity: 0.6;
    user-select: none;
  }
  @media (max-width: 1020px) {
    .hero-kanji {
      top: auto;
      bottom: 4%;
      right: -18%;
      font-size: 100vw;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-kanji {
      animation: flicker 7s linear infinite;
    }
  }
  @keyframes flicker {
    0%,
    18%,
    22%,
    62%,
    64.5%,
    100% {
      opacity: 0.6;
    }
    20%,
    63% {
      opacity: 0.25;
    }
  }
  .hero-floor {
    position: absolute;
    left: -25%;
    right: -25%;
    bottom: -8%;
    height: 55%;
    background:
      linear-gradient(to bottom, var(--bg), transparent 40%),
      repeating-linear-gradient(90deg, rgb(255 43 214 / 0.45) 0 1px, transparent 1px 80px),
      repeating-linear-gradient(0deg, rgb(34 229 255 / 0.4) 0 1px, transparent 1px 80px);
    transform: perspective(600px) rotateX(64deg);
    transform-origin: 50% 100%;
    mask-image: linear-gradient(to top, #000 10%, transparent 90%);
    opacity: 0.55;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-floor {
      animation: floor 3s linear infinite;
    }
  }
  @keyframes floor {
    to {
      background-position:
        0 0,
        0 0,
        0 80px;
    }
  }

  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  @media (max-width: 1020px) {
    .hero-in {
      grid-template-columns: 1fr;
    }
  }

  .hero-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .hero-hud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--muted);
  }
  .hero-hud span {
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgb(255 255 255 / 0.02);
  }
  .hero-hud .p1 {
    color: #1a0418;
    background: var(--amber);
    border-color: var(--amber);
    box-shadow: 0 0 16px -2px var(--amber);
  }
  h1 {
    display: grid;
    font-size: clamp(3rem, 6.6vw, 6.1rem);
    text-wrap: balance;
  }
  h1 span:first-child {
    color: #fff;
    text-shadow: 0 0 28px rgb(255 255 255 / 0.18);
  }
  h1 .grad-text {
    padding-bottom: 0.08em;
  }
  .hero-eq {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    font: 700 1.05rem/1 var(--f-mono);
    color: var(--dim);
  }
  .hero-eq b {
    color: var(--text);
  }
  .hero-eq .kanji {
    font: 900 1.35rem/1 var(--f-kanji);
    color: var(--mag);
    text-shadow: 0 0 10px rgb(255 43 214 / 0.8);
  }
  .hero-eq .name {
    font: 900 1.2rem/1 var(--f-display);
  }
  .hero-eq em {
    font-style: normal;
    color: var(--mag);
  }
  .hero-eq small {
    flex-basis: 100%;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-lede {
    max-width: 36rem;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--muted);
  }
  .hero-follow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    color: var(--cyan);
    text-decoration: none;
    text-shadow: 0 0 12px rgb(34 229 255 / 0.5);
  }
  .hero-follow svg {
    width: 1rem;
    fill: currentColor;
  }
  .hero-follow:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-stage {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.68rem;
  }
  .hero-chips li::before {
    content: '▸ ';
    color: var(--mag);
  }
</style>
