---
import { finale, footer, x } from '../copy';
import Download from '../../components/Download.astro';
import LaunchForm from './LaunchForm.astro';
import PixelFist from './PixelFist.astro';
---

<section class="section finale" id="join" aria-labelledby="finale-title">
  <div class="wrap finale-in">
    <div class="continue" aria-hidden="true">
      <p class="continue-label hud">{finale.continueLabel}</p>
      <p class="continue-n" data-countdown>9</p>
      <PixelFist class="continue-fist" palette="neon" />
    </div>
    <div class="finale-copy">
      <h2 class="display" id="finale-title"><span class="grad-text">{finale.title}</span></h2>
      <p class="finale-body">{finale.body}</p>
      <Download placement="v1-footer" primary="btn" secondary="btn btn-ghost" class="v1-download" />
      <LaunchForm placement="v1-footer" />
      <a class="btn btn-ghost" href={x.url} rel="me" data-track="follow_x_clicked" data-placement="v1-footer">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
          ><path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          ></path></svg
        >
        {finale.follow}
      </a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer-in">
    <div>
      <p>{footer.made}</p>
      <p>{footer.legal}</p>
    </div>
    <p class="footer-links"><a href="/privacy/">{footer.privacy}</a><a href="#top">{footer.top}</a></p>
  </div>
</footer>

<style>
  .finale {
    position: relative;
    overflow: clip;
    background:
      radial-gradient(40rem 26rem at 20% 50%, rgb(255 43 214 / 0.16), transparent 70%),
      radial-gradient(40rem 26rem at 85% 60%, rgb(34 229 255 / 0.1), transparent 70%);
    border-top: 1px solid rgb(255 255 255 / 0.05);
  }
  .finale-in {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  @media (max-width: 900px) {
    .finale-in {
      grid-template-columns: 1fr;
    }
  }
  .continue {
    position: relative;
    display: grid;
    justify-items: center;
    padding: 2rem 1rem;
  }
  .continue-label {
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    letter-spacing: 0.3em;
    color: var(--cyan-hi);
    text-shadow: 0 0 14px var(--cyan);
  }
  .continue-n {
    font: italic 900 clamp(10rem, 22vw, 17rem) / 0.9 var(--f-display);
    color: var(--amber);
    -webkit-text-stroke: 8px #1a0600;
    paint-order: stroke fill;
    text-shadow:
      0 10px 0 #b3321c,
      0 0 60px rgb(255 182 39 / 0.6);
    font-variant-numeric: tabular-nums;
  }
  @media (prefers-reduced-motion: no-preference) {
    .continue-n.is-tick {
      animation: pop 360ms var(--ease-spring);
    }
  }
  .continue :global(.continue-fist) {
    position: absolute;
    right: 8%;
    bottom: 10%;
    width: 5.5rem;
    height: auto;
    rotate: -12deg;
    filter: drop-shadow(0 0 16px rgb(255 43 214 / 0.8));
  }
  .finale-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .finale-copy h2 {
    font-size: clamp(3rem, 7vw, 6rem);
  }
  .finale-body {
    max-width: 34rem;
    font-size: 1.15rem;
    color: var(--muted);
  }
</style>
