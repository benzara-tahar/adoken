---
import { fightCard as fc } from '../copy';
import Icon from './Icon.astro';
---

<section class="section fight" id="fight" aria-labelledby="fight-title">
  <div class="wrap fight-in">
    <header class="section-head" data-reveal>
      <p class="eyebrow hud">{fc.eyebrow}</p>
      <h2 class="display" id="fight-title">{fc.title}</h2>
      <p>{fc.intro}</p>
      <p class="fight-note">{fc.note}</p>
    </header>

    <div class="fc-wrap" data-reveal style="--delay:120ms">
      <div class="app fc" role="img" aria-label={`Mock weekly fight card for the ${fc.week.toLowerCase()}: ${fc.tiles.map((t) => `${t.label} ${t.value}`).join(', ')}.`}>
        <div class="fc-head" aria-hidden="true">
          <div>
            <p class="hud fc-kicker">Weekly fight card</p>
            <p class="fc-week">{fc.week}</p>
          </div>
          <span class="fc-emblem" lang="ja">拳</span>
        </div>
        <div class="fc-tiles" aria-hidden="true">
          {
            fc.tiles.map((t) => (
              <div class="fc-tile">
                <p class="hud">{t.label}</p>
                <p class="fc-val">
                  {t.value.startsWith('×') ? (
                    <>
                      <small>×</small>
                      <b data-count-to={t.value.slice(1)}>{t.value.slice(1)}</b>
                    </>
                  ) : (
                    <b data-count-to={t.value}>{t.value}</b>
                  )}
                </p>
                <p class="fc-sub">{t.sub}</p>
              </div>
            ))
          }
        </div>
        <div class="fc-minor" aria-hidden="true">
          {
            fc.minor.map(([k, v]) => (
              <p>
                <span>{k}</span>
                <b>{v}</b>
              </p>
            ))
          }
        </div>
        <div class="fc-bottom" aria-hidden="true">
          <div class="fc-kos">
            <p class="hud fc-label">{fc.kosTitle}</p>
            {
              fc.kos.map((ko) => (
                <p class="fc-ko">
                  <span class="fc-ko-badge">K.O.</span>
                  <span class="fc-ko-t">
                    <b>{ko.id}</b> {ko.title}
                  </span>
                  <span class="fc-ko-w">{ko.when}</span>
                </p>
              ))
            }
          </div>
          <div class="fc-streak">
            <p class="hud fc-label">{fc.streakTitle}</p>
            <div class="fc-grid">
              {fc.days.map((d) => <span class="fc-day">{d}</span>)}
              {fc.grid.map((n) => <i data-level={n === 0 ? 'shield' : n >= 6 ? '3' : n >= 3 ? '2' : '1'} />)}
            </div>
          </div>
        </div>
        <div class="fc-actions" aria-hidden="true">
          <span class="vbtn">{fc.actions[0]}</span>
          <span class="vbtn fc-export"><Icon name="file" />{fc.actions[1]}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .fight-in {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .fight-in .section-head {
    margin-bottom: 0;
  }
  @media (max-width: 1020px) {
    .fight-in {
      grid-template-columns: 1fr;
    }
  }
  .fight-note {
    padding-top: 1rem;
    font: 0.85rem/1.5 var(--f-mono) !important;
    color: var(--dim) !important;
    border-top: 1px solid var(--line);
  }
  .fc-wrap {
    position: relative;
  }
  .fc-wrap::before {
    content: '';
    position: absolute;
    inset: 10% 5%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(255 182 39 / 0.25), transparent);
    filter: blur(30px);
  }
  .fc {
    display: grid;
    gap: 16px;
    padding: 22px;
    background:
      radial-gradient(90% 60% at 100% 0%, rgb(255 182 39 / 0.14), transparent 60%),
      radial-gradient(70% 50% at 0% 100%, rgb(255 43 214 / 0.12), transparent 60%),
      var(--a-bg);
    border-radius: 18px;
    rotate: -1.2deg;
  }
  .fc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .fc-kicker {
    font-size: 10px;
    color: var(--a-warn);
  }
  .fc-week {
    margin-top: 4px;
    font: 900 24px/1.1 var(--f-display);
  }
  .fc-emblem {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    font: 900 32px/1 var(--f-brush);
    color: #1a0418;
    background: linear-gradient(145deg, var(--mag-hi), var(--mag));
    border-radius: 12px;
    box-shadow: 0 0 24px -4px var(--mag);
    rotate: 6deg;
  }
  .fc-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  @container (max-width: 520px) {
    .fc-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .fc-tile {
    display: grid;
    gap: 4px;
    padding: 12px;
    background: var(--a-panel);
    border: 1px solid var(--a-line);
    border-radius: 12px;
  }
  .fc-tile .hud {
    font-size: 9.5px;
    color: var(--a-muted);
  }
  .fc-val {
    font: italic 900 44px/1 var(--f-display);
    color: var(--a-warn);
    -webkit-text-stroke: 3px #2a0a00;
    paint-order: stroke fill;
    text-shadow:
      0 3px 0 #b3321c,
      0 0 22px rgb(255 182 39 / 0.5);
    font-variant-numeric: tabular-nums;
  }
  .fc-val small {
    font-size: 0.6em;
  }
  .fc-tile:nth-child(2) .fc-val {
    color: var(--mag-hi);
    text-shadow:
      0 3px 0 #8a0f72,
      0 0 22px rgb(255 43 214 / 0.5);
  }
  .fc-tile:nth-child(3) .fc-val {
    color: var(--cyan-hi);
    text-shadow:
      0 3px 0 #0b6d80,
      0 0 22px rgb(34 229 255 / 0.5);
  }
  .fc-tile:nth-child(4) .fc-val {
    color: var(--lime);
    text-shadow:
      0 3px 0 #2c7a18,
      0 0 22px rgb(141 255 106 / 0.45);
  }
  .fc-sub {
    font-size: 11.5px;
    color: var(--a-muted);
  }
  .fc-minor {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    padding: 10px 0;
    border-block: 1px dashed var(--a-line);
  }
  @container (max-width: 520px) {
    .fc-minor {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .fc-minor p {
    display: grid;
  }
  .fc-minor span {
    font-size: 11px;
    color: var(--a-muted);
  }
  .fc-minor b {
    font: 800 16px var(--f-display);
  }
  .fc-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
  }
  @container (max-width: 520px) {
    .fc-bottom {
      grid-template-columns: 1fr;
    }
  }
  .fc-label {
    margin-bottom: 8px;
    font-size: 9.5px;
    color: var(--a-muted);
  }
  .fc-ko {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 5px 0;
  }
  .fc-ko-badge {
    padding: 2px 5px;
    font: italic 900 10px/1.2 var(--f-display);
    color: #1a0600;
    background: var(--a-warn);
    border-radius: 4px;
  }
  .fc-ko-t {
    overflow: hidden;
    font-size: 12.5px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .fc-ko-t b {
    font: 700 11px var(--f-mono);
    color: var(--a-accent);
  }
  .fc-ko-w {
    font: 10.5px var(--f-mono);
    color: var(--a-muted);
  }
  .fc-grid {
    display: grid;
    grid-template-columns: repeat(5, 18px);
    gap: 5px;
  }
  .fc-day {
    font: 700 9px var(--f-mono);
    text-align: center;
    color: var(--a-muted);
  }
  .fc-grid i {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--lime) 30%, transparent);
  }
  .fc-grid i[data-level='2'] {
    background: color-mix(in srgb, var(--lime) 60%, transparent);
  }
  .fc-grid i[data-level='3'] {
    background: var(--lime);
    box-shadow: 0 0 10px -2px var(--lime);
  }
  .fc-grid i[data-level='shield'] {
    background: transparent;
    border: 1.5px dashed var(--cyan);
  }
  .fc-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
  .fc-export {
    color: #1a0418;
    background: var(--a-accent);
    border-color: transparent;
  }
</style>
