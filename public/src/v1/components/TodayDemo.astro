---
/** Move 04: the Today view with smart nudges and pipeline stages. CSS-only motion. */
import { demo } from '../copy';
import Icon from './Icon.astro';

const t = demo.today;
const STAGES = ['Build', 'Unit', 'Integration', 'Deploy'];
---

<div class="app today" role="img" aria-label={`Mock of the adoken Today view: ${t.stats.map((s) => `${s.value} ${s.label}`).join(', ')}; three nudges (a review waiting 3 days, a failed build, a merge conflict) and pipeline stages.`}>
  <div class="app-bar" aria-hidden="true">
    <span class="lights"><i></i><i></i><i></i></span>
    <span class="app-title">{demo.org} · Today</span>
  </div>
  <div class="today-body" aria-hidden="true">
    <div class="day">
      <p class="day-h"><Icon name="sun" /><b>{t.title}</b><span>{t.date}</span></p>
      <div class="day-stats">
        {
          t.stats.map((s) => (
            <p>
              <b>{s.value}</b>
              <span>{s.label}</span>
            </p>
          ))
        }
      </div>
    </div>

    <p class="today-sec"><span>{t.nudgesTitle}</span><em>{t.nudgesCap}</em></p>
    <ul class="nudges">
      {
        t.nudges.map((n, i) => (
          <li class="nudge" data-tone={n.tone} style={`--i:${i}`}>
            <span class="nudge-ico">
              <Icon name={n.icon} />
            </span>
            <span class="nudge-main">
              <b>{n.title}</b>
              <span>{n.detail}</span>
            </span>
            <span class="nudge-go">{n.action}</span>
          </li>
        ))
      }
    </ul>

    <p class="today-sec"><span>{t.pipelinesTitle}</span><em>{STAGES.join(' · ')}</em></p>
    <ul class="pipes">
      {
        t.pipelines.map((p) => (
          <li>
            <span class="pipe-n">
              <b>{p.name}</b>
              <span>{p.branch}</span>
            </span>
            <span class="pipe-stages">
              {p.stages.map((s, i) => (
                <i data-s={s} title={STAGES[i]} />
              ))}
            </span>
            <span class="pipe-t">{p.time}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .today-body {
    display: grid;
    gap: 12px;
    padding: 16px;
  }
  .day {
    display: grid;
    gap: 12px;
    padding: 14px 16px;
    background:
      radial-gradient(120% 140% at 100% 0%, color-mix(in srgb, var(--a-warn) 16%, transparent), transparent 60%),
      var(--a-panel);
    border: 1px solid var(--a-line);
    border-radius: 12px;
  }
  .day-h {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .day-h :global(.ico) {
    color: var(--a-warn);
  }
  .day-h b {
    font-size: 15px;
  }
  .day-h span {
    margin-left: auto;
    font: 11px var(--f-mono);
    color: var(--a-muted);
  }
  .day-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .day-stats p {
    display: grid;
    gap: 2px;
  }
  .day-stats b {
    font: 900 30px/1 var(--f-display);
    color: var(--a-text);
  }
  .day-stats p:first-child b {
    color: var(--a-accent);
    text-shadow: 0 0 18px color-mix(in srgb, var(--a-accent) 60%, transparent);
  }
  .day-stats span {
    font-size: 11.5px;
    line-height: 1.3;
    color: var(--a-muted);
  }
  .today-sec {
    display: flex;
    justify-content: space-between;
    margin-top: 4px;
    font: 700 10.5px var(--f-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--a-muted);
  }
  .today-sec em {
    font-style: normal;
    letter-spacing: 0.02em;
    text-transform: none;
    opacity: 0.8;
  }
  .nudges,
  .pipes {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nudge {
    --c: var(--a-warn);
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    background: color-mix(in srgb, var(--c) 7%, var(--a-bg));
    border: 1px solid color-mix(in srgb, var(--c) 28%, transparent);
    border-radius: 10px;
  }
  .nudge[data-tone='red'] {
    --c: var(--a-del);
  }
  .nudge[data-tone='cyan'] {
    --c: var(--a-accent-2);
  }
  .nudge-ico {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 16%, transparent);
    border-radius: 8px;
  }
  .nudge-main {
    display: grid;
    min-width: 0;
  }
  .nudge-main b,
  .nudge-main span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .nudge-main b {
    font-weight: 650;
  }
  .nudge-main span {
    font-size: 11.5px;
    color: var(--a-muted);
  }
  .nudge-go {
    padding: 4px 10px;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--c);
    border: 1px solid color-mix(in srgb, var(--c) 50%, transparent);
    border-radius: 7px;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.is-in) .nudge {
      animation: rise 420ms var(--ease-out) both;
      animation-delay: calc(300ms + var(--i) * 160ms);
    }
  }
  .pipes li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 36px;
    align-items: center;
    gap: 12px;
    padding: 6px 10px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--a-panel) 60%, transparent);
  }
  .pipe-n {
    display: grid;
    min-width: 0;
  }
  .pipe-n b {
    font: 600 12px var(--f-mono);
  }
  .pipe-n span {
    overflow: hidden;
    font: 10.5px var(--f-mono);
    color: var(--a-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .pipe-stages {
    display: flex;
    gap: 4px;
  }
  .pipe-stages i {
    width: 26px;
    height: 8px;
    border-radius: 3px;
    background: var(--a-line);
  }
  .pipe-stages i[data-s='ok'] {
    background: var(--a-add);
  }
  .pipe-stages i[data-s='fail'] {
    background: var(--a-del);
    box-shadow: 0 0 10px var(--a-del);
  }
  .pipe-stages i[data-s='run'] {
    background: var(--a-warn);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pipe-stages i[data-s='run'] {
      animation: blink 1.1s ease-in-out infinite;
    }
  }
  .pipe-t {
    font: 10.5px var(--f-mono);
    color: var(--a-muted);
    text-align: right;
  }
  @container (max-width: 460px) {
    .pipe-stages i {
      width: 14px;
    }
  }
</style>
