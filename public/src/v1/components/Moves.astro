---
import { moves } from '../copy';
import PaletteDemo from './PaletteDemo.astro';
import ReviewDemo from './ReviewDemo.astro';
import InboxDemo from './InboxDemo.astro';
import TodayDemo from './TodayDemo.astro';

const DEMOS = { palette: PaletteDemo, review: ReviewDemo, inbox: InboxDemo, today: TodayDemo } as const;
---

<section class="section moves" id="moves" aria-labelledby="moves-title">
  <div class="wrap">
    <div class="moves-top">
      <header class="section-head" data-reveal>
        <p class="eyebrow hud">{moves.eyebrow}</p>
        <h2 class="display" id="moves-title">{moves.title}</h2>
        <p>{moves.intro}</p>
      </header>
      <div class="card" data-reveal style="--delay:120ms">
        <p class="card-h hud"><span>{moves.commandCard.title}</span><span class="card-p1">1P</span></p>
        <ul>
          {
            moves.commandCard.rows.map((row) => (
              <li>
                <span class="keys">
                  {row.keys.map((k) => (
                    <kbd class="key">{k}</kbd>
                  ))}
                </span>
                <b>{row.move}</b>
                <i aria-hidden="true" />
                <span class="card-does">{row.does}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="move-list">
      {
        moves.items.map((move, i) => {
          const Demo = DEMOS[move.id];
          return (
            <article class:list={['move', { flip: i % 2 === 1 }]} id={`move-${move.id}`} data-reveal>
              <div class="move-copy">
                <p class="move-tag hud">
                  <span class="move-n">{move.n}</span>
                  <span class="move-type">{move.type}</span>
                </p>
                <p class="move-name">
                  <span class="display">{move.name}</span>
                  <i aria-hidden="true" />
                  <span class="keys">
                    {move.keys.map((k) => (
                      <kbd class="key">{k}</kbd>
                    ))}
                  </span>
                </p>
                <h3 class="display">{move.title}</h3>
                <p class="move-body">{move.body}</p>
                <dl class="move-stats">
                  {move.stats.map(([k, v]) => (
                    <div>
                      <dt class="hud">{k}</dt>
                      <dd>{v}</dd>
                    </div>
                  ))}
                </dl>
                {'footnote' in move && (
                  <p class="move-foot">
                    {move.footnote}{' '}
                    <a href={move.footnoteLink} rel="noopener">
                      {move.footnoteCta}
                    </a>
                  </p>
                )}
              </div>
              <div class="move-demo">
                <Demo />
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .moves-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
    gap: 3rem;
    align-items: end;
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }
  .moves-top .section-head {
    margin-bottom: 0;
  }
  @media (max-width: 960px) {
    .moves-top {
      grid-template-columns: 1fr;
    }
  }

  /* Cabinet instruction card */
  .card {
    padding: 1.1rem 1.25rem 1.25rem;
    background:
      linear-gradient(180deg, rgb(255 182 39 / 0.08), transparent 40%),
      var(--panel);
    border: 1px solid rgb(255 182 39 / 0.3);
    border-radius: 1rem;
    box-shadow:
      0 0 0 4px rgb(255 182 39 / 0.04),
      0 0 40px -18px var(--amber);
    rotate: 1.2deg;
  }
  .card-h {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.8rem;
    padding-bottom: 0.7rem;
    color: var(--amber);
    border-bottom: 1px dashed rgb(255 182 39 / 0.35);
  }
  .card-p1 {
    padding: 0.2rem 0.4rem;
    color: #1a0e00;
    background: var(--amber);
    border-radius: 0.2rem;
  }
  .card ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card li {
    display: grid;
    grid-template-columns: 6.6rem auto 1fr auto;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
  }
  .card .key {
    min-width: 1.6rem;
    height: 1.6rem;
    font-size: 0.72rem;
  }
  .card b {
    font-weight: 750;
  }
  .card li i {
    height: 1px;
    border-bottom: 2px dotted rgb(255 255 255 / 0.16);
  }
  .card-does {
    font: 0.72rem var(--f-mono);
    color: var(--dim);
  }

  /* Moves */
  .move-list {
    display: grid;
    gap: clamp(6rem, 12vw, 10rem);
  }
  .move {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .move.flip {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  }
  .move.flip .move-copy {
    order: 2;
  }
  @media (max-width: 1020px) {
    .move,
    .move.flip {
      grid-template-columns: 1fr;
    }
    .move.flip .move-copy {
      order: 0;
    }
  }
  .move-copy {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .move-tag {
    display: flex;
    gap: 0.5rem;
  }
  .move-n {
    padding: 0.35rem 0.5rem;
    color: #12021a;
    background: var(--cyan);
    border-radius: 0.3rem;
    box-shadow: 0 0 16px -2px var(--cyan);
  }
  .move-type {
    padding: 0.35rem 0.5rem;
    color: var(--cyan);
    border: 1px solid rgb(34 229 255 / 0.45);
    border-radius: 0.3rem;
  }
  .move-name {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    max-width: 30rem;
  }
  .move-name .display {
    font-size: 1.35rem;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--mag-hi);
    text-shadow: 0 0 16px rgb(255 43 214 / 0.6);
    white-space: nowrap;
  }
  .move-name i {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 2px dotted rgb(255 255 255 / 0.2);
  }
  .move h3 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    text-wrap: balance;
  }
  .move-body {
    max-width: 34rem;
    color: var(--muted);
  }
  .move-stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 0.6rem 1.8rem;
    margin: 0.4rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .move-stats dt {
    font-size: 0.65rem;
    color: var(--dim);
  }
  .move-stats dd {
    margin: 0.3rem 0 0;
    font: 800 1rem/1.2 var(--f-display);
    color: var(--amber-hi);
  }
  .move-foot {
    max-width: 34rem;
    padding: 0.8rem 1rem;
    font-size: 0.9rem;
    color: var(--muted);
    background: rgb(34 229 255 / 0.05);
    border-left: 3px solid var(--cyan);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .move-demo {
    position: relative;
    min-width: 0;
  }
  .move-demo::before {
    content: '';
    position: absolute;
    inset: 8% -4% -6%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(255 43 214 / 0.22), transparent);
    filter: blur(20px);
  }
  .move:nth-child(even) .move-demo::before {
    background: radial-gradient(closest-side, rgb(34 229 255 / 0.2), transparent);
  }
  @media (max-width: 560px) {
    .move-stats {
      grid-template-columns: repeat(2, auto);
    }
    .card li {
      grid-template-columns: 5.2rem auto 1fr;
    }
    .card-does {
      display: none;
    }
  }
</style>
