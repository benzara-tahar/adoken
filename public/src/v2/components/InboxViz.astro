---
/** An email flood folds into one grouped inbox card; quiet hours switch on; snooze sends it to tomorrow. */
import { bento } from '../copy';
import { icons } from '../lib';

const b = bento.inbox;
---

<div class="mock ibx" data-inbox aria-hidden="true">
  <div class="ibx-stage">
    <div class="ibx-mail" data-mail>
      <div class="ibx-mail-head">
        <span>{b.mailLabel}</span>
        <span class="ibx-flood num" data-flood>{b.floodCount}</span>
      </div>
      <ul>
        {
          b.mails.map((subject, i) => (
            <li style={`--i:${i}`}>
              <i />
              <span class="ibx-from">Azure DevOps</span>
              <span class="ibx-subj">{subject}</span>
              <span class="ibx-t">11:{String(58 - i * 3).padStart(2, '0')}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="ibx-group is-in" data-group>
      <div class="ibx-g-head">
        <span class="ibx-g-ico" set:html={icons.pr} />
        <span class="ibx-g-id">{b.grouped.id}</span>
        <span class="ibx-g-why">{b.grouped.why}</span>
        <span class="ibx-g-count num" data-group-count>{b.grouped.count}</span>
      </div>
      <p class="ibx-g-title">{b.grouped.title}</p>
      <p class="ibx-g-sum">{b.grouped.summary}</p>
      <div class="ibx-g-actions">
        <span class="ibx-snooze" data-snooze><span class="kbd"><kbd>S</kbd></span>{b.snooze.label}</span>
        <span class="ibx-done"><span class="kbd"><kbd>E</kbd></span>Done</span>
      </div>
      <ul class="ibx-menu is-open" data-menu>
        {b.snooze.options.map((option, i) => <li class:list={{ 'is-sel': i === b.snooze.picked }}>{option}</li>)}
      </ul>
    </div>
    <div class="ibx-snoozed" data-snoozed>
      <span set:html={icons.moon} />
      {b.snooze.done} {b.snooze.options[b.snooze.picked]}
    </div>
  </div>

  <div class="ibx-quiet is-on" data-quiet>
    <span class="ibx-q-ico" set:html={icons.moon} />
    <span class="ibx-q-text">
      <b>{b.quiet.label}</b>
      <span>{b.quiet.value}</span>
    </span>
    <span class="ibx-held">{b.quiet.held}</span>
    <span class="ibx-toggle"><i></i></span>
  </div>
</div>

<script>
  import { loop } from '../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-inbox]');
  loop(root, async (scene) => {
    const $ = (sel: string) => root!.querySelector<HTMLElement>(sel)!;
    const mail = $('[data-mail]');
    const rows = [...mail.querySelectorAll('li')];
    const flood = $('[data-flood]');
    const group = $('[data-group]');
    const count = $('[data-group-count]');
    const menu = $('[data-menu]');
    const items = [...menu.querySelectorAll('li')];
    const quiet = $('[data-quiet]');
    const snoozed = $('[data-snoozed]');

    // reset: an empty morning mailbox
    group.classList.remove('is-in', 'is-gone');
    menu.classList.remove('is-open');
    items.forEach((item) => item.classList.remove('is-sel'));
    quiet.classList.remove('is-on');
    snoozed.classList.remove('is-on');
    mail.classList.remove('is-folding');
    mail.classList.add('is-live');
    rows.forEach((row) => row.classList.remove('is-in'));
    flood.textContent = '0 emails';
    await scene.sleep(500);

    // the flood
    for (const [i, row] of rows.entries()) {
      row.classList.add('is-in');
      flood.textContent = `${(i + 1) * 2} emails`;
      await scene.sleep(170);
    }
    await scene.sleep(900);

    // fold into one row
    mail.classList.add('is-folding');
    await scene.sleep(450);
    group.classList.add('is-in');
    for (let n = 1; n <= 18; n++) {
      count.textContent = String(n);
      await scene.sleep(22);
    }
    await scene.sleep(1000);

    quiet.classList.add('is-on');
    await scene.sleep(1200);

    menu.classList.add('is-open');
    for (const i of [0, 1]) {
      items.forEach((item, j) => item.classList.toggle('is-sel', i === j));
      await scene.sleep(420);
    }
    await scene.sleep(350);
    menu.classList.remove('is-open');
    group.classList.add('is-gone');
    snoozed.classList.add('is-on');
    await scene.sleep(2200);
  });
</script>

<style>
  .ibx {
    display: flex;
    flex-direction: column;
    min-height: 430px;
  }
  .ibx-stage {
    position: relative;
    flex: 1;
    min-height: 320px;
    overflow: hidden;
  }

  /* the email stack */
  .ibx-mail {
    position: absolute;
    inset: 0;
    padding: 12px 12px 0;
    opacity: 0;
  }
  .ibx-mail.is-live {
    opacity: 1;
  }
  .ibx-mail-head {
    display: flex;
    justify-content: space-between;
    padding: 0 4px 8px;
    font-size: 11.5px;
    color: var(--app-muted);
  }
  .ibx-flood {
    font-weight: 700;
    color: var(--app-del);
  }
  .ibx-mail ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ibx-mail li {
    display: grid;
    grid-template-columns: 6px auto 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 6px 9px;
    font-size: 11.5px;
    border-radius: 7px;
    background: color-mix(in srgb, var(--app-text) 5%, transparent);
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease);
  }
  .ibx-mail li.is-in {
    opacity: 1;
    transform: none;
  }
  .ibx-mail li i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4c8dff;
  }
  .ibx-from {
    font-weight: 600;
    white-space: nowrap;
  }
  .ibx-subj {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: color-mix(in srgb, var(--app-text) 80%, transparent);
  }
  .ibx-t {
    color: var(--app-muted);
  }
  .ibx-mail.is-folding li {
    opacity: 0;
    transform: translateY(calc(var(--i) * -34px)) scale(0.9);
    transition:
      opacity 0.45s calc(var(--i) * 25ms),
      transform 0.55s var(--ease) calc(var(--i) * 25ms);
  }
  .ibx-mail.is-folding .ibx-mail-head {
    opacity: 0;
    transition: opacity 0.3s;
  }

  /* the grouped card */
  .ibx-group {
    position: absolute;
    top: 16px;
    left: 14px;
    right: 14px;
    padding: 14px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--app-raise) 95%, transparent);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--app-accent) 35%, var(--app-line)),
      0 20px 40px -20px rgb(0 0 0 / 0.8),
      0 0 40px -16px color-mix(in srgb, var(--app-accent) 60%, transparent);
    opacity: 0;
    transform: scale(0.92) translateY(-6px);
    transition:
      opacity 0.35s,
      transform 0.5s var(--spring);
  }
  .ibx-group.is-in {
    opacity: 1;
    transform: none;
  }
  .ibx-group.is-gone {
    opacity: 0;
    transform: translateX(40px) scale(0.96);
    transition:
      opacity 0.4s,
      transform 0.5s var(--ease);
  }
  .ibx-g-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    color: var(--app-muted);
  }
  .ibx-g-ico {
    color: var(--app-accent);
  }
  .ibx-g-ico :global(svg) {
    width: 14px;
  }
  .ibx-g-id {
    font-family: var(--mono);
  }
  .ibx-g-count {
    margin-left: auto;
    min-width: 26px;
    padding: 2px 7px;
    font-weight: 700;
    text-align: center;
    color: var(--app-bg);
    border-radius: 99px;
    background: var(--app-accent);
  }
  .ibx-g-title {
    margin-top: 8px;
    font-weight: 600;
    font-size: 13.5px;
  }
  .ibx-g-sum {
    margin-top: 2px;
    font-size: 11.5px;
    color: var(--app-muted);
  }
  .ibx-g-actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }
  .ibx-g-actions > span {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px 4px 5px;
    font-size: 11.5px;
    border-radius: 7px;
    background: color-mix(in srgb, var(--app-text) 6%, transparent);
  }
  .ibx-menu {
    position: absolute;
    top: calc(100% - 8px);
    left: 14px;
    z-index: 2;
    display: grid;
    width: 170px;
    margin: 0;
    padding: 4px;
    list-style: none;
    border-radius: 10px;
    background: color-mix(in srgb, var(--app-raise) 96%, var(--app-text));
    box-shadow:
      inset 0 0 0 1px var(--app-line),
      0 20px 40px -12px rgb(0 0 0 / 0.8);
    opacity: 0;
    transform: translateY(-4px) scale(0.97);
    transform-origin: top left;
    transition:
      opacity 0.2s,
      transform 0.3s var(--spring);
  }
  .ibx-menu.is-open {
    opacity: 1;
    transform: none;
  }
  .ibx-menu li {
    padding: 6px 9px;
    font-size: 11.5px;
    border-radius: 6px;
  }
  .ibx-menu li.is-sel {
    color: var(--app-bg);
    background: var(--app-accent);
  }
  .ibx-snoozed {
    position: absolute;
    top: 40px;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-size: 12px;
    white-space: nowrap;
    border-radius: 99px;
    background: color-mix(in srgb, var(--app-raise) 96%, transparent);
    box-shadow: inset 0 0 0 1px var(--app-line);
    opacity: 0;
    translate: -50% 8px;
    transition:
      opacity 0.35s,
      translate 0.5s var(--spring);
  }
  .ibx-snoozed :global(svg) {
    width: 13px;
    color: var(--syn-t);
  }
  .ibx-snoozed.is-on {
    opacity: 1;
    translate: -50% 0;
  }

  /* quiet hours */
  .ibx-quiet {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-top: 1px solid var(--app-line);
    background: color-mix(in srgb, var(--app-panel) 80%, transparent);
  }
  .ibx-q-ico {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    color: var(--app-muted);
    background: color-mix(in srgb, var(--app-text) 6%, transparent);
    transition:
      color 0.3s,
      background-color 0.3s;
  }
  .ibx-q-ico :global(svg) {
    width: 14px;
  }
  .ibx-quiet.is-on .ibx-q-ico {
    color: var(--syn-t);
    background: color-mix(in srgb, var(--syn-t) 14%, transparent);
  }
  .ibx-q-text {
    display: grid;
    flex: none;
    font-size: 11.5px;
    color: var(--app-muted);
    white-space: nowrap;
  }
  .ibx-q-text b {
    font-size: 12.5px;
    color: var(--app-text);
  }
  .ibx-held {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 11px;
    text-align: right;
    color: var(--syn-t);
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0;
    transition: opacity 0.3s 0.2s;
  }
  .ibx-quiet.is-on .ibx-held {
    opacity: 1;
  }
  .ibx-toggle {
    position: relative;
    flex: none;
    width: 34px;
    height: 20px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--app-text) 15%, transparent);
    transition: background-color 0.3s;
  }
  .ibx-toggle i {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.4);
    transition: transform 0.35s var(--spring);
  }
  .ibx-quiet.is-on .ibx-toggle {
    background: var(--app-accent);
  }
  .ibx-quiet.is-on .ibx-toggle i {
    transform: translateX(14px);
  }
</style>
