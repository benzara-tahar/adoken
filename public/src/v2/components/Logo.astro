---
/** The v2 mark: 拳 in a frosted rounded tile with an accent edge. Original art. */
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<span class="mark" style={`--s:${size}px`} aria-hidden="true"><span>拳</span></span>

<style>
  .mark {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--s);
    height: var(--s);
    border-radius: calc(var(--s) * 0.3);
    background:
      radial-gradient(120% 90% at 30% 0%, color-mix(in srgb, var(--accent-fg) 55%, transparent), transparent 60%),
      linear-gradient(160deg, color-mix(in srgb, var(--accent) 32%, var(--bg)), color-mix(in srgb, var(--accent) 8%, var(--bg)));
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--accent-hi) 35%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 6px 20px -6px color-mix(in srgb, var(--accent) 70%, transparent);
  }
  .mark span {
    font: 700 calc(var(--s) * 0.56) / 1 var(--ken);
    color: #fff;
    text-shadow: 0 0 12px color-mix(in srgb, var(--accent-hi) 90%, transparent);
  }
</style>
