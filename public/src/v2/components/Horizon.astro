---
import { horizon } from '../copy';
import { icons } from '../lib';
---

<section class="section" id="horizon">
  <div class="wrap">
    <div class="section-head rv">
      <span class="eyebrow">{horizon.eyebrow}</span>
      <h2 class="h2">{horizon.title}</h2>
      <p class="lede">{horizon.lede}</p>
    </div>
    <ol class="hz">
      {
        horizon.stages.map((stage, i) => (
          <li class:list={['hz-card', 'rv', { 'is-now': i === 0 }]} style={`--d:${i * 0.07}s`} data-spot>
            <div class="hz-top">
              <span class="hz-node" />
              <span class="hz-when">{stage.when}</span>
              {stage.status && <span class="hz-status">{stage.status}</span>}
            </div>
            <h3>{stage.name}</h3>
            <ul>
              {stage.items.map((item) => (
                <li>
                  <span set:html={icons.check} />
                  {item}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hz {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hz::before {
    /* the road: one hairline through every node */
    content: '';
    position: absolute;
    top: 33px;
    left: 24px;
    right: 24px;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 25%, transparent) 30%, var(--line) 70%, transparent);
  }
  .hz-card {
    position: relative;
    padding: 24px;
    border-radius: 20px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.01)), rgb(14 14 22 / 0.6);
    border: 1px solid var(--line);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: border-color 0.3s;
  }
  .hz-card:hover {
    border-color: var(--line-2);
  }
  .hz-card.is-now {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    box-shadow: 0 30px 60px -30px color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .hz-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hz-node {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 1.5px var(--faint);
  }
  .is-now .hz-node {
    background: var(--accent);
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent),
      0 0 14px var(--accent);
  }
  .hz-when {
    font: 600 0.84rem/1 var(--mono);
    color: var(--soft);
  }
  .hz-status {
    margin-left: auto;
    padding: 3px 8px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent-ink);
    border-radius: 99px;
    background: var(--accent-hi);
  }
  .hz-card h3 {
    margin: 22px 0 14px;
    font: 600 1.35rem/1.1 var(--sans);
    letter-spacing: -0.03em;
  }
  .hz-card ul {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hz-card ul li {
    display: flex;
    gap: 9px;
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--soft);
  }
  .hz-card ul li :global(svg) {
    flex: none;
    width: 14px;
    margin-top: 2px;
    color: var(--faint);
  }
  .is-now ul li :global(svg) {
    color: var(--accent-hi);
  }
  @media (max-width: 1000px) {
    .hz {
      grid-template-columns: repeat(2, 1fr);
    }
    .hz::before {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .hz {
      grid-template-columns: 1fr;
    }
  }
</style>
