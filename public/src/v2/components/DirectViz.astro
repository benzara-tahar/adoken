---
/** Your Mac ⇄ dev.azure.com, packets flowing on one wire, the middleman crossed out. */
import { bento } from '../copy';

const d = bento.direct;
---

<div class="dv" aria-hidden="true">
  <div class="dv-row">
    <span class="dv-node">
      <svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="11" rx="2"></rect><path d="M2 19h20"></path></svg>
      {d.you}
    </span>
    <span class="dv-wire"><i></i><i></i><i></i><b></b><b></b></span>
    <span class="dv-node dv-ado">
      <svg viewBox="0 0 24 24"><path d="M4 16V8l7-4 9 3v10l-9 3z"></path><path d="m11 4v16"></path></svg>
      {d.ado}
    </span>
  </div>
  <div class="dv-them">
    <span class="dv-x">
      <svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="6" rx="1.5"></rect><rect x="5" y="14" width="14" height="6" rx="1.5"></rect></svg>
      <s>{d.them}</s>
    </span>
  </div>
</div>

<style>
  .dv {
    display: grid;
    gap: 16px;
    padding: 6px 22px 26px;
  }
  .dv-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
  }
  .dv-node {
    display: grid;
    justify-items: center;
    gap: 6px;
    font-size: 0.74rem;
    color: var(--soft);
  }
  .dv-node svg {
    width: 44px;
    height: 44px;
    padding: 10px;
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
    stroke-linejoin: round;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .dv-ado svg {
    stroke: #7cc4ff;
    background: rgb(124 196 255 / 0.08);
  }
  .dv-wire {
    position: relative;
    height: 2px;
    margin-bottom: 22px;
    overflow: hidden;
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 20%, transparent), rgb(124 196 255 / 0.2));
    border-radius: 2px;
  }
  .dv-wire i,
  .dv-wire b {
    position: absolute;
    top: 0;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-hi));
    box-shadow: 0 0 10px var(--accent);
  }
  .dv-wire b {
    background: linear-gradient(270deg, transparent, #9edbff);
    box-shadow: 0 0 10px #7cc4ff;
  }
  .dv-wire i {
    left: 0;
  }
  .dv-wire b {
    right: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dv-wire i {
      animation: wire-r 1.8s linear infinite;
    }
    .dv-wire b {
      animation: wire-l 2.2s linear infinite;
    }
    .dv-wire i:nth-child(2) {
      animation-delay: -0.6s;
    }
    .dv-wire i:nth-child(3) {
      animation-delay: -1.2s;
    }
    .dv-wire b:nth-of-type(2) {
      animation-delay: -1.1s;
    }
  }
  @keyframes wire-r {
    from {
      transform: translateX(-30px);
    }
    to {
      transform: translateX(400px);
    }
  }
  @keyframes wire-l {
    from {
      transform: translateX(30px);
    }
    to {
      transform: translateX(-400px);
    }
  }
  .dv-them {
    display: flex;
    justify-content: center;
  }
  .dv-x {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 8px;
    font-size: 0.76rem;
    color: var(--faint);
    border-radius: 10px;
    border: 1px dashed rgb(255 107 129 / 0.35);
  }
  .dv-x svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--faint);
    stroke-width: 1.5;
  }
  .dv-x s {
    text-decoration-color: var(--bad);
    text-decoration-thickness: 1.5px;
  }
</style>
