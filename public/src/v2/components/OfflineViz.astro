---
/** Offline ↔ back online: the queue never goes away, drafts wait, sync catches up in under a second. */
import { app, bento } from '../copy';
import { avatarStyle, icons } from '../lib';

const o = bento.offline;
const rows = app.prs.slice(0, 3);
---

<div class="mock off" data-offline aria-hidden="true">
  <div class="off-head">
    <span class="off-pill" data-pill>
      <span class="off-i-plane" set:html={icons.plane} />
      <span class="off-i-wifi" set:html={icons.wifi} />
      <span data-status>{o.status[0]}</span>
    </span>
    <span class="off-alt num">35,000 ft</span>
  </div>
  <ul class="off-rows">
    {
      rows.map((pr) => (
        <li>
          <span class="avatar" style={avatarStyle(pr.hue)}>
            {pr.who}
          </span>
          <span class="off-title">{pr.title}</span>
          <span class="off-sync" />
        </li>
      ))
    }
  </ul>
  <div class="off-foot" data-detail>{o.detail[0]} · {o.drafts}</div>
</div>

<script>
  import { bento } from '../copy';
  import { loop } from '../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-offline]');
  loop(root, async (scene) => {
    const status = root!.querySelector<HTMLElement>('[data-status]')!;
    const detail = root!.querySelector<HTMLElement>('[data-detail]')!;
    const { status: labels, detail: details, drafts } = bento.offline;
    root!.classList.remove('is-online');
    status.textContent = labels[0];
    detail.textContent = `${details[0]} · ${drafts}`;
    await scene.sleep(3200);
    root!.classList.add('is-online');
    status.textContent = labels[1];
    detail.textContent = details[1];
    await scene.sleep(3000);
  });
</script>

<style>
  .off-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
  }
  .off-pill {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px 4px 8px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--syn-t);
    border-radius: 99px;
    background: color-mix(in srgb, var(--syn-t) 13%, transparent);
    transition:
      color 0.4s,
      background-color 0.4s;
  }
  .off-pill :global(svg) {
    width: 13px;
  }
  .off-i-wifi,
  .is-online .off-i-plane {
    display: none;
  }
  .is-online .off-i-wifi {
    display: block;
  }
  .is-online .off-pill {
    color: var(--app-add);
    background: color-mix(in srgb, var(--app-add) 13%, transparent);
  }
  .off-alt {
    font-size: 11px;
    color: var(--app-muted);
    transition: opacity 0.4s;
  }
  .is-online .off-alt {
    opacity: 0;
  }
  .off-rows {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0 8px;
    list-style: none;
  }
  .off-rows li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    border-radius: 8px;
  }
  .off-title {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .off-sync {
    flex: none;
    width: 6px;
    height: 6px;
    margin-left: auto;
    border-radius: 50%;
    background: color-mix(in srgb, var(--app-text) 20%, transparent);
    transition: background-color 0.3s;
  }
  .is-online .off-sync {
    background: var(--app-add);
  }
  @media (prefers-reduced-motion: no-preference) {
    .is-online .off-rows li {
      animation: synced 0.9s var(--ease) both;
    }
    .is-online .off-rows li:nth-child(2) {
      animation-delay: 0.08s;
    }
    .is-online .off-rows li:nth-child(3) {
      animation-delay: 0.16s;
    }
  }
  .off-foot {
    padding: 10px 14px 14px;
    font-size: 11.5px;
    color: var(--app-muted);
  }
  @keyframes synced {
    30% {
      background: color-mix(in srgb, var(--app-add) 12%, transparent);
    }
  }
</style>
