---
/** A frosted bento card: copy + keyboard hints on top, a live mini-mock (slot) below. */
interface Props {
  title: string;
  body: string;
  keys?: readonly (readonly string[])[];
  class?: string;
  id?: string;
  delay?: number;
}
const { title, body, keys = [], class: className, id, delay = 0 } = Astro.props;
---

<article class:list={['card', 'rv', className]} id={id} data-spot style={`--d:${delay}s`}>
  <div class="card-copy">
    <div class="card-head">
      <h3>{title}</h3>
      {
        keys.length > 0 && (
          <span class="card-keys">
            {keys.map((combo) => (
              <span class="kbd">
                {combo.map((key) => (
                  <kbd>{key}</kbd>
                ))}
              </span>
            ))}
          </span>
        )
      }
    </div>
    <p>{body}</p>
  </div>
  <div class="card-viz"><slot /></div>
</article>

<style>
  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border-radius: 22px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.045), rgb(255 255 255 / 0.012)), rgb(14 14 22 / 0.62);
    border: 1px solid var(--line);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 30px 60px -40px rgb(0 0 0 / 0.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  /* cursor spotlight: a soft fill plus a brighter hairline, both following --mx/--my */
  .card::before,
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .card::before {
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--accent) 11%, transparent), transparent 45%);
  }
  .card::after {
    z-index: 3;
    padding: 1px;
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--accent-hi) 65%, transparent), transparent 50%);
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
  }
  .card:hover::before,
  .card:hover::after {
    opacity: 1;
  }
  .card-copy {
    display: grid;
    gap: 8px;
    padding: 26px 26px 0;
  }
  .card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .card h3 {
    font: 600 1.18rem/1.25 var(--sans);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .card p {
    max-width: 52ch;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }
  .card-keys {
    display: flex;
    gap: 6px;
    flex: none;
    padding-top: 2px;
  }
  .card-viz {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 0;
    padding: 22px 0 0;
  }
</style>
