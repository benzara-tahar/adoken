---
/** Keycaps that light up in sequence, each with the action it runs. */
import { bento } from '../copy';

const list = bento.keys.list;
---

<ul class="ky" style={`--n:${list.length}`} aria-hidden="true">
  {
    list.map((item, i) => (
      <li style={`--i:${i}`}>
        <span class="ky-caps">
          {item.keys.map((key) => (
            <kbd>{key}</kbd>
          ))}
        </span>
        <span class="ky-l">{item.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .ky {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0 22px 24px;
    list-style: none;
  }
  .ky li {
    display: grid;
    justify-items: start;
    gap: 7px;
    padding: 10px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.03);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .ky-caps {
    display: flex;
    gap: 4px;
  }
  .ky kbd {
    display: grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    padding: 0 7px;
    font: 500 0.82rem/1 var(--text-font);
    color: var(--text);
    border-radius: 7px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.04));
    border: 1px solid var(--line-2);
    box-shadow: 0 2px 0 rgb(0 0 0 / 0.55);
  }
  .ky-l {
    font-size: 0.74rem;
    color: var(--muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ky kbd {
      animation: ky-press calc(var(--n) * 0.7s) var(--ease) infinite;
      animation-delay: calc(var(--i) * 0.7s);
    }
  }
  @keyframes ky-press {
    0% {
      transform: translateY(2px);
      box-shadow:
        0 0 0 rgb(0 0 0 / 0.55),
        0 0 18px -2px color-mix(in srgb, var(--accent) 90%, transparent);
      border-color: color-mix(in srgb, var(--accent-hi) 75%, transparent);
      color: #fff;
    }
    8%,
    100% {
      transform: none;
    }
  }
</style>
