---
import { closing, footer, x } from '../copy';
import LaunchForm from './LaunchForm.astro';
import Logo from './Logo.astro';
import { recordingConsent } from '../../copy';
---

<section class="close" id="launch">
  <div class="close-halo" aria-hidden="true"></div>
  <div class="wrap close-in">
    <div class="close-mark rv"><Logo size={64} /></div>
    <h2 class="close-title rv" style="--d:.05s">
      <span>{closing.title[0]}</span>
      <span>{closing.title[1]}</span>
    </h2>
    <p class="lede rv" style="--d:.1s">{closing.lede}</p>
    <div class="close-form rv" style="--d:.15s">
      <LaunchForm placement="v2-footer" />
      <a class="btn btn-ghost" href={x.url} rel="me noopener" data-track="follow_x_clicked" data-placement="v2-footer">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.3L5.3 21H2.2l7.2-8.3L1.8 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z"
          ></path></svg
        >
        {closing.follow}
      </a>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="wrap foot-in">
    <div class="foot-brand">
      <Logo size={22} />
      <span>{footer.made}</span>
    </div>
    <a href="/privacy/">{footer.privacy}</a>
    <button class="recording-settings" data-recording-settings type="button" hidden>{recordingConsent.settings}</button>
    <p class="foot-legal">{footer.legal} {footer.mock}</p>
  </div>
</footer>

<style>
  .close {
    position: relative;
    padding: clamp(96px, 14vw, 180px) 0 clamp(80px, 10vw, 120px);
    overflow: hidden;
    text-align: center;
  }
  .close-halo {
    position: absolute;
    left: 50%;
    bottom: -72%;
    width: 1800px;
    height: 1000px;
    translate: -50% 0;
    background:
      radial-gradient(30% 45% at 50% 50%, color-mix(in srgb, var(--accent) 20%, transparent), transparent),
      radial-gradient(18% 26% at 62% 42%, color-mix(in srgb, var(--amber) 10%, transparent), transparent);
    pointer-events: none;
  }
  .close-halo::before {
    /* a horizon arc */
    content: '';
    position: absolute;
    top: 24%;
    left: 50%;
    width: min(1100px, 150vw);
    height: 100%;
    translate: -50% 0;
    border-radius: 50%;
    border-top: 1px solid color-mix(in srgb, var(--accent-hi) 60%, transparent);
    box-shadow: inset 0 28px 56px -28px color-mix(in srgb, var(--accent) 38%, transparent);
  }
  .close-in {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 22px;
  }
  .close-title {
    display: grid;
    font: 650 clamp(2.5rem, 7vw, 5.2rem) / 1 var(--sans);
    letter-spacing: -0.055em;
    background: linear-gradient(180deg, #fff 40%, rgb(255 255 255 / 0.55));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .close .lede {
    max-width: 520px;
  }
  .close-form {
    display: grid;
    justify-items: center;
    gap: 18px;
    width: 100%;
    margin-top: 12px;
  }
  .close-form :global(.lf) {
    justify-items: center;
  }
  .close-form :global(.lf-os) {
    justify-content: center;
  }

  .foot {
    padding: 28px 0 96px;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--muted);
  }
  .foot-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
  }
  .foot-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--soft);
  }
  .foot a {
    color: var(--soft);
    text-underline-offset: 3px;
  }
  .foot-legal {
    flex-basis: 100%;
    color: var(--faint);
  }
  .recording-settings {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--soft);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
</style>
