---
/** 目次: a magazine table of contents for the seven chapters. */
import { chapters } from '../copy';
---

<section id="chapters" class="contents section" aria-labelledby="contents-title">
  <div class="wrap contents-grid">
    <div>
      <p class="eyebrow">{chapters.eyebrow}</p>
      <h2 id="contents-title" class="h2">{chapters.title}</h2>
      <p class="body contents-intro">{chapters.intro}</p>
    </div>
    <ol class="toc">
      {
        chapters.toc.map(([num, name, href], i) => (
          <li>
            <a href={href}>
              <span class="toc-num jp" lang="ja">{num}</span>
              <span class="toc-name">{name}</span>
              <span class="toc-dots" aria-hidden="true" />
              <span class="toc-page">{String(i + 1).padStart(2, '0')}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .contents {
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  .contents-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
  }

  .contents-grid .h2 {
    margin: 1rem 0 1.4rem;
  }

  .toc {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }

  .toc a {
    display: grid;
    grid-template-columns: 3.2rem auto 1fr auto;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.75rem 0.2rem;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: padding 0.3s var(--ease);
  }

  .toc a:hover {
    padding-left: 0.8rem;
  }

  .toc-num {
    font-size: 1.6rem;
    line-height: 1;
  }

  .toc-name {
    font: 500 clamp(1.3rem, 2vw, 1.7rem) / 1.1 var(--serif);
    letter-spacing: -0.015em;
  }

  .toc a:hover .toc-name {
    font-style: italic;
  }

  .toc-dots {
    border-bottom: 1.5px dotted var(--dim);
    transform: translateY(-0.3rem);
  }

  .toc-page {
    font: 500 0.85rem/1 var(--mono);
    color: var(--dim);
  }

  @media (max-width: 860px) {
    .contents-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
