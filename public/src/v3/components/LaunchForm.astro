---
/**
 * Launch-list signup for /v3/: a plain HTML form posting to Buttondown (works with JS off).
 * Same fields and tracking as the shared LaunchForm, styled for paper.
 */
import { buttondown } from '../../integrations';
import { launchList } from '../copy';

interface Props {
  placement: 'v3-hero' | 'v3-footer';
  /** Optional heading-sized label (defaults to the shared label). */
  label?: string;
}
const { placement, label = launchList.emailLabel } = Astro.props;
const id = `launch-${placement}`;
---

<form
  class="lf"
  action={buttondown.subscribeUrl}
  method="post"
  data-track="launch_list_submitted"
  data-placement={placement}
>
  <label class="lf-label" for={`${id}-email`}>{label}</label>
  <div class="lf-row">
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder={launchList.placeholder}
    />
    <button class="btn" type="submit">{launchList.submit}</button>
  </div>
  <fieldset class="lf-os">
    <legend>{launchList.osLegend}</legend>
    {
      launchList.os.map((os) => (
        <label>
          <input type="radio" name="metadata__os" value={os} />
          <span>{os}</span>
        </label>
      ))
    }
  </fieldset>
  <input type="hidden" name="metadata__placement" value={placement} />
  <input type="hidden" name="metadata__source" value="direct" data-launch-source />
  <p class="lf-fine">{launchList.fine} <a href="/privacy/">{launchList.privacy}</a></p>
</form>

<script>
  // Attribute signups: our own `?ref=` tags first, then utm_source, then the referring site.
  const params = new URLSearchParams(location.search);
  const referrer = document.referrer ? new URL(document.referrer).hostname : '';
  const source =
    params.get('ref') ?? params.get('utm_source') ?? (referrer && referrer !== location.hostname ? referrer : '');
  if (source) {
    for (const input of document.querySelectorAll<HTMLInputElement>('[data-launch-source]')) {
      input.value = source.slice(0, 64);
    }
  }
</script>

<style>
  .lf {
    display: grid;
    gap: 0.8rem;
    width: min(100%, 36rem);
  }

  .lf-label {
    font: 650 0.95rem/1.35 var(--sans);
  }

  .lf-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .lf-row input {
    flex: 1 1 15rem;
    min-width: 0;
    min-height: 3rem;
    padding: 0.7rem 1.1rem;
    font: 400 1.05rem/1.2 var(--serif);
    color: var(--ink);
    background: rgb(255 252 245 / 0.65);
    border: 1.5px solid var(--ink);
    border-radius: 999px;
  }

  .lf-row input::placeholder {
    color: var(--dim);
    font-style: italic;
  }

  .lf-row input:focus-visible {
    outline: 2px solid var(--shu);
    outline-offset: 2px;
  }

  .lf-row .btn {
    flex: 0 0 auto;
  }

  .lf-os {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    font: 400 0.84rem/1.3 var(--sans);
    color: var(--ink-2);
  }

  .lf-os legend {
    float: left;
    margin-right: 0.35rem;
    padding: 0;
  }

  .lf-os label {
    position: relative;
    cursor: pointer;
  }

  .lf-os input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .lf-os span {
    display: inline-block;
    padding: 0.28rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    transition:
      background 0.15s,
      color 0.15s,
      border-color 0.15s;
  }

  .lf-os input:checked + span {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  .lf-os input:focus-visible + span {
    outline: 2px solid var(--shu);
    outline-offset: 2px;
  }

  .lf-fine {
    margin: 0;
    font: 400 0.8rem/1.5 var(--sans);
    color: var(--dim);
  }

  .lf-fine a {
    color: var(--ink);
  }
</style>
