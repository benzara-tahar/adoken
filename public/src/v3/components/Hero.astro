---
import BrushKen from './BrushKen.astro';
import Hanko from './Hanko.astro';
import Follow from './Follow.astro';
import LaunchForm from './LaunchForm.astro';
import HeroMock from './HeroMock.astro';
import { hero, masthead } from '../copy';

const [l1, l2, l3] = hero.title;
---

<header class="mast wrap">
  <div class="mast-top">
    <a class="mast-logo" href="/v3/">
      <Hanko text="拳" class="mast-seal" />
      <span>adoken</span>
    </a>
    <p class="mast-issue"><span>{masthead.issue}</span> · {masthead.season} · <em>{masthead.strap}</em></p>
    <nav class="mast-nav" aria-label="Sections">
      {masthead.nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <Follow class="btn-ghost mast-follow" label={masthead.follow} placement="v3-masthead" />
  </div>
  <hr class="rule-double" />
</header>

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">{hero.kicker}</p>
    <h1 id="hero-title" class="display">
      <span>{l1}</span>
      <span>{l2}</span>
      <em class="stroke-word">{l3}</em>
    </h1>
    <p class="dek hero-lede">{hero.lede}</p>
    <LaunchForm placement="v3-hero" />
    <div class="hero-follow">
      <Follow class="btn-ghost" label={hero.follow} placement="v3-hero" />
      <span>{hero.platforms}</span>
    </div>
  </div>

  <div class="hero-art">
    <BrushKen class="hero-brush" />
    <p class="vert hero-vert" lang="ja">
      {hero.vertical}<span class="sr-only" lang="en"> ({hero.verticalGloss})</span>
    </p>
    <Hanko text="一撃" class="hero-seal" />
    <p class="hero-def">
      <span class="jp" lang="ja">拳</span>
      <span class="hero-def-body"><b>{hero.ken.reading}</b> <i>{hero.ken.gloss}</i></span>
    </p>
  </div>
</section>

<div class="wrap">
  <ul class="facts">
    {
      hero.facts.map(([v, l]) => (
        <li>
          <b>{v}</b>
          <span>{l}</span>
        </li>
      ))
    }
  </ul>
</div>

<div class="wrap hero-shot">
  <HeroMock />
</div>

<script>
  // The brush and the swash under "stroke." draw in with CSS animations whose `from` keyframe is
  // blank. If the animation clock never advances (tab loaded in the background, frozen, occluded,
  // or animations paused by tooling) they would stay blank forever. After the draw-in has had its
  // wall-clock time, pin the finished state; it is identical to the animation's end state.
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) {
    const pin = () => hero.classList.add('inked');
    if (document.visibilityState === 'hidden') pin();
    else setTimeout(pin, 5000);
  }
</script>

<style>
  .mast {
    padding-top: 1.1rem;
  }

  .mast-top {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 0.9rem;
  }

  .mast-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font: 600 1.6rem/1 var(--serif);
    letter-spacing: -0.02em;
  }

  .mast-logo :global(.mast-seal) {
    width: 2.3rem;
    height: 2.3rem;
    rotate: -4deg;
  }

  .mast-issue {
    margin: 0;
    font: 500 0.78rem/1.3 var(--sans);
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  .mast-issue span {
    font-weight: 700;
    color: var(--ink);
  }

  .mast-issue em {
    font-family: var(--serif);
    font-size: 1.05em;
  }

  .mast-nav {
    display: flex;
    gap: 1.4rem;
    font: 500 0.88rem/1 var(--sans);
  }

  .mast-nav a {
    text-decoration: none;
  }

  .mast-nav a:hover {
    text-decoration: underline;
  }

  .mast :global(.mast-follow) {
    min-height: 2.4rem;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  /* ---------- Hero ---------- */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2rem;
    padding-top: clamp(2.5rem, 6vw, 5.5rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: start;
    gap: 1.8rem;
  }

  .display span {
    display: block;
  }

  .stroke-word {
    position: relative;
    display: inline-block;
    color: var(--ink);
  }

  .stroke-word::after {
    /* a vermilion brush swash under "stroke." */
    content: '';
    position: absolute;
    left: -0.04em;
    right: 0.1em;
    bottom: 0.02em;
    height: 0.14em;
    z-index: -1;
    background: var(--shu);
    border-radius: 40% 60% 55% 45% / 60% 40% 60% 40%;
    transform: skewX(-12deg) rotate(-1.5deg);
    transform-origin: left center;
    opacity: 0.9;
  }

  .hero-lede {
    max-width: 30em;
  }

  .hero-follow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.2rem;
    font: 500 0.82rem/1.3 var(--sans);
    color: var(--dim);
  }

  .hero-art {
    position: relative;
    min-height: 34rem;
  }

  .hero-art :global(.hero-brush) {
    position: absolute;
    top: -2rem;
    right: 2.4rem;
    width: min(108%, 40rem);
    height: auto;
  }

  .hero-vert {
    position: absolute;
    top: 0.5rem;
    right: -0.4rem;
    margin: 0;
    font-size: 1.15rem;
    line-height: 1;
    color: var(--ink-2);
    padding-top: 0.9rem;
    border-top: 2px solid var(--shu);
  }

  .hero-art :global(.hero-seal) {
    position: absolute;
    right: 0;
    top: 16rem;
    width: 3.2rem;
    rotate: 3deg;
  }

  .hero-def {
    position: absolute;
    left: 12%;
    top: 37rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    padding: 0.7rem 1rem 0.7rem 0.8rem;
    font: 400 0.92rem/1.3 var(--serif);
    border-left: 2px solid var(--ink);
  }

  .hero-def .jp {
    font-size: 2rem;
    line-height: 1;
  }

  .hero-def-body b {
    font-weight: 700;
  }

  .hero-def-body i {
    color: var(--ink-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .stroke-word::after {
      animation: v3-swash 0.7s cubic-bezier(0.6, 0, 0.3, 1) 3.9s backwards;
    }
  }

  .hero.inked .stroke-word::after,
  .hero.inked :global(.brush-mask),
  .hero.inked :global(.brush-drops) {
    animation: none;
  }

  @keyframes v3-swash {
    from {
      transform: skewX(-12deg) rotate(-1.5deg) scaleX(0);
    }
  }

  /* ---------- Facts ---------- */

  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .facts li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 1.1rem 1.4rem;
  }

  .facts li + li {
    border-left: 1px solid var(--rule);
  }

  .facts b {
    font: 500 clamp(1.8rem, 3vw, 2.6rem)/1 var(--serif);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .facts span {
    font: 500 0.82rem/1.3 var(--sans);
    color: var(--ink-2);
  }

  .hero-shot {
    padding-top: clamp(3rem, 6vw, 5.5rem);
  }

  .hero-shot :global(.hero-photo) {
    --tilt: -0.9deg;
    max-width: 1180px;
    margin-inline: auto;
  }

  /* ---------- Tablet & phone ---------- */

  @media (max-width: 1080px) {
    .mast-nav {
      display: none;
    }

    .mast-top {
      grid-template-columns: auto 1fr auto;
    }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.6rem;
    }

    /* Headline first, then the brush, then the rest: no blank band above the fold. */
    .hero-copy {
      display: contents;
    }

    .hero-copy > .eyebrow {
      order: -3;
    }

    .hero-copy > .display {
      order: -2;
    }

    .hero-art {
      order: -1;
      min-height: 0;
      height: min(80vw, 24rem);
      margin: 0.4rem 0 0.2rem;
    }

    .hero-art :global(.hero-brush) {
      top: 0;
      right: 12%;
      width: auto;
      height: calc(100% - 3.4rem);
    }

    .hero-art :global(.hero-seal) {
      top: auto;
      bottom: 1rem;
      right: 1.2rem;
      width: 2.6rem;
    }

    .hero-def {
      left: 0;
      top: auto;
      bottom: 0;
      font-size: 0.82rem;
      padding: 0.4rem 0.6rem;
    }

    .hero-def .jp {
      font-size: 1.5rem;
    }

    .hero-vert {
      font-size: 1rem;
      right: 0;
    }

    .mast-issue em {
      display: none;
    }

    .facts {
      grid-template-columns: 1fr;
    }

    .facts li + li {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }

    .facts li {
      padding: 0.8rem 0.2rem;
    }
  }

  @media (max-width: 520px) {
    .mast-issue {
      display: none;
    }

    .mast-top {
      grid-template-columns: auto auto;
      justify-content: space-between;
    }
  }
</style>
