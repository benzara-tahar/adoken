---
/**
 * The Race: the browser vs adoken on the same review, side by side with stopwatches, ending in a
 * vermilion 済 ("done") stamp. Default markup is the finish line (reduced motion / no JS).
 */
import Hanko from './Hanko.astro';
import Icon from './Icon.astro';
import Palette from './mock/Palette.astro';
import PrView from './mock/PrView.astro';
import { demo, race } from '../copy';

const tabs = ['Outlook', 'PR 4127', 'Boards', 'PR 4127', 'Pipelines', 'Wiki', 'PR 4098', 'Sign in', 'Sprint 214', 'PR 4127', 'Repos', 'Teams', 'Query', 'PR 4131'];
---

<section id="race" class="race section done" aria-labelledby="race-title">
  <div class="wrap race-head">
    <p class="eyebrow">{race.eyebrow}</p>
    <h2 id="race-title" class="race-title"><span class="jp" lang="ja">競</span>{race.title}</h2>
    <p class="dek race-dek">{race.dek}</p>
  </div>

  <div class="wrap race-track" data-race>
    <div class="lane lane-web">
      <header class="lane-head">
        <div>
          <p class="lane-name">{race.left.label}</p>
          <p class="lane-sub">{race.left.sub}</p>
        </div>
        <p class="clock" aria-label="Browser stopwatch"><span data-clock="web">03:31.4</span><i aria-hidden="true">▸▸</i></p>
      </header>
      <figure class="photo lane-photo">
        <div class="photo-frame">
          <div class="bw" role="img" aria-label="A browser with fourteen tabs open on Azure DevOps, stuck on a loading spinner where the diff should be.">
            <div class="bw-tabs">
              {
                tabs.map((t, i) => (
                  <span class:list={['bw-tab', { on: i === 9 }]} style={`--i:${i}`}>
                    <i />
                    {t}
                  </span>
                ))
              }
            </div>
            <div class="bw-bar">
              <span class="bw-nav">‹ ›</span>
              <Icon name="reload" class="bw-reload" />
              <span class="bw-url">{demo.browserUrl}</span>
              <span class="bw-mail"><Icon name="mail" /><b data-mail>52</b></span>
            </div>
            <div class="bw-page">
              <div class="bw-rail">{Array.from({ length: 7 }, () => <i />)}</div>
              <div class="bw-main">
                <div class="bw-crumbs"><i /><i /><i /></div>
                <div class="bw-title">Pull request 4127</div>
                <div class="bw-tabsrow"><span>Overview</span><span class="on">Files</span><span>Updates</span><span>Commits</span></div>
                <div class="bw-load">
                  <span class="bw-spin"></span>
                  <span>Loading…</span>
                </div>
                <div class="bw-skel">{Array.from({ length: 6 }, (_, i) => <i style={`--w:${[92, 70, 84, 55, 76, 64][i]}%`} />)}</div>
              </div>
              <div class="bw-inbox">
                <p class="bw-inbox-h"><Icon name="mail" /> Inbox <b>47 unread</b></p>
                {demo.emails.slice(0, 7).map((e) => <p class="bw-mailrow">{e}</p>)}
              </div>
              <div class="bw-signin">
                <p>Pick an account</p>
                <i /><i />
              </div>
            </div>
          </div>
        </div>
      </figure>
      <ol class="lane-log">{race.leftLog.map((l) => <li class="lit">{l}</li>)}</ol>
    </div>

    <div class="race-vs" aria-hidden="true"><span class="jp">対</span></div>

    <div class="lane lane-ado">
      <header class="lane-head">
        <div>
          <p class="lane-name">{race.right.label}</p>
          <p class="lane-sub">{race.right.sub}</p>
        </div>
        <p class="clock clock-ado" aria-label="adoken stopwatch"><span data-clock="ado">00:06.8</span></p>
      </header>
      <figure class="photo lane-photo" style="--tilt:0.8deg">
        <div class="photo-frame">
          <div
            class="win mock race-win is-pr is-thread is-reply is-approved"
            data-ink="dojo-night"
            role="img"
            aria-label="adoken: Cmd+P finds the pull request from a typo, the diff opens instantly, a reply goes inline and the review is approved."
          >
            <div class="win-bar"><i></i><i></i><i></i><span class="win-title">adoken</span></div>
            <div class="app race-app">
              <div class="main">
                <PrView slam={false} />
                <Palette limit={3} />
              </div>
            </div>
            <div class="keycast"></div>
          </div>
        </div>
        <Hanko text={race.stamp} class="race-stamp" label={race.stampGloss} />
      </figure>
      <ol class="lane-log">{race.rightLog.map((l) => <li class="lit">{l}</li>)}</ol>
    </div>
  </div>

  <div class="wrap race-foot">
    <p class="race-verdict">{race.verdict}</p>
    <button class="btn btn-ghost race-replay" type="button" hidden>{race.replay}</button>
    <p class="fig race-note">{race.note}</p>
  </div>
</section>

<script>
  import { motionOK, play, scene } from '../scripts/stage';

  const track = document.querySelector<HTMLElement>('[data-race]');
  const section = track?.closest<HTMLElement>('.race');
  if (track && section && motionOK) {
    const win = track.querySelector<HTMLElement>('.race-win')!;
    const q = win.querySelector('.pal-q')!;
    const reply = win.querySelector('.msg-me .typed')!;
    const keycast = win.querySelector('.keycast')!;
    const webClock = track.querySelector('[data-clock="web"]')!;
    const adoClock = track.querySelector('[data-clock="ado"]')!;
    const mail = track.querySelector('[data-mail]')!;
    const logs = [...track.querySelectorAll('.lane-log')].map((ol) => [...ol.children]);
    const replay = section.querySelector<HTMLButtonElement>('.race-replay')!;
    const query = q.textContent ?? '';
    const replyText = 'LGTM, ship it.';

    const fmt = (ms: number) => {
      const m = Math.floor(ms / 60000);
      const s = (ms % 60000) / 1000;
      return `${String(m).padStart(2, '0')}:${s.toFixed(1).padStart(4, '0')}`;
    };
    const keys = (html: string) => {
      keycast.innerHTML = html;
      keycast.classList.add('show');
    };
    const light = (lane: number, step: number) => logs[lane][step]?.classList.add('lit');

    let t0 = 0;
    let adoStop = 0;
    let raf = 0;
    const tick = () => {
      const t = performance.now() - t0;
      webClock.textContent = fmt(t * 30);
      adoClock.textContent = fmt(adoStop || t);
      mail.textContent = String(47 + Math.min(9, Math.floor(t / 900)));
      raf = requestAnimationFrame(tick);
    };

    const restart = play(
      track,
      async (s) => {
        replay.hidden = true;
        section.classList.remove('done');
        for (const lane of logs) for (const li of lane) li.classList.remove('lit');
        track.dataset.web = 'mail';
        q.textContent = '';
        reply.textContent = '';
        keycast.classList.remove('show');
        scene(win, 'blank');
        adoStop = 0;
        await s.wait(600);

        t0 = performance.now();
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(tick);
        light(0, 0);
        keys('<kbd>⌘</kbd><kbd>P</kbd>');
        light(1, 0);
        await s.wait(250);
        scene(win, 'blank', 'palette', 'typing');
        for (const [i, ch] of [...query].entries()) {
          q.textContent += ch;
          if (i === 1) scene(win, 'blank', 'palette', 'typing', 'results');
          await s.wait(110);
        }
        scene(win, 'blank', 'palette', 'typing', 'results', 'fixed');
        light(1, 1);
        keycast.classList.remove('show');
        await s.wait(700);
        track.dataset.web = 'signin';
        light(0, 1);
        keys('<kbd>↵</kbd>');
        await s.wait(200);
        scene(win, 'pr');
        light(1, 2);
        await s.wait(900);
        scene(win, 'pr', 'thread');
        await s.wait(500);
        track.dataset.web = 'tabs';
        light(0, 2);
        keys('<kbd>R</kbd><span>reply</span>');
        scene(win, 'pr', 'thread', 'reply');
        light(1, 3);
        await s.type(reply, replyText, 55);
        await s.wait(700);
        track.dataset.web = 'files';
        light(0, 3);
        keys('<kbd>A</kbd><span>approve</span>');
        await s.wait(250);
        scene(win, 'pr', 'thread', 'reply', 'approved');
        light(1, 4);
        await s.wait(900);
        adoStop = 6800;
        light(1, 5);
        section.classList.add('done');
        keycast.classList.remove('show');
        track.dataset.web = 'reload';
        light(0, 4);
        await s.wait(1600);
        track.dataset.web = 'files';
        light(0, 5);
        await s.wait(1400);
        cancelAnimationFrame(raf);
        replay.hidden = false;
      },
      { loop: false, threshold: 0.45 },
    );
    replay.addEventListener('click', restart);
  }
</script>

<style>
  .race {
    background: rgb(200 180 145 / 0.2);
    border-block: 1px solid var(--ink);
  }

  .race-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: 1rem 3rem;
  }

  .race-head .eyebrow {
    grid-column: 1 / -1;
  }

  .race-title {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.25em;
    font: 500 clamp(4rem, 12vw, 11rem) / 0.85 var(--serif);
    letter-spacing: -0.045em;
  }

  .race-title .jp {
    font-size: 0.5em;
    padding: 0.12em;
    color: var(--paper);
    background: var(--ink);
    border-radius: 0.08em;
    letter-spacing: 0;
    font-weight: 600;
  }

  .race-dek {
    max-width: 30em;
    padding-bottom: 0.8rem;
  }

  .race-track {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 2.5rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .lane {
    display: grid;
    align-content: start;
    gap: 1.2rem;
  }

  .lane-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 2px solid var(--ink);
  }

  .lane-name {
    margin: 0;
    font: 600 1.6rem/1.1 var(--serif);
    letter-spacing: -0.02em;
  }

  .lane-ado .lane-name {
    font-style: italic;
  }

  .lane-sub {
    margin: 0.2rem 0 0;
    font: 400 0.82rem/1.3 var(--sans);
    color: var(--dim);
  }

  .clock {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    font: 500 clamp(1.8rem, 3.2vw, 2.8rem) / 1 var(--mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
  }

  .clock i {
    font-style: normal;
    font-size: 0.4em;
    color: var(--dim);
    letter-spacing: 0;
  }

  .clock-ado {
    color: var(--ink);
  }

  .race.done .clock-ado {
    color: var(--shu);
  }

  .race-vs {
    display: grid;
    justify-items: center;
    align-content: center;
    position: relative;
  }

  .race-vs::before {
    content: '';
    position: absolute;
    inset: 0 50%;
    width: 1px;
    background: var(--ink);
    opacity: 0.35;
  }

  .race-vs .jp {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    font-size: 1.3rem;
    background: var(--paper-2);
    border: 1px solid var(--ink);
    border-radius: 50%;
  }

  .lane-photo {
    --tilt: -0.8deg;
    position: relative;
  }

  .lane-log {
    display: grid;
    gap: 0.35rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    font: 400 0.95rem/1.35 var(--serif);
  }

  .lane-log li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem 1fr;
    color: var(--dim);
    transition: color 0.3s;
  }

  .lane-log li::before {
    content: counter(step, cjk-ideographic);
    font-family: var(--mincho);
    color: var(--dim);
    transition: color 0.3s;
  }

  .lane-log li.lit {
    color: var(--ink);
  }

  .lane-log li.lit::before {
    color: var(--shu);
  }

  .lane-ado .lane-log li:last-child.lit {
    color: var(--shu);
    font-style: italic;
  }

  /* ---------- The browser mock (a generic browser, not a copy of any product UI) ---------- */

  .bw {
    --b-bg: #fbfaf8;
    --b-chrome: #e7e3dc;
    --b-line: #d3cdc2;
    --b-tx: #2a2723;
    --b-dim: #5c574f;
    position: relative;
    font: 400 clamp(6px, calc(100cqw / 52), 13px) / 1.35 var(--sans);
    color: var(--b-tx);
    background: var(--b-bg);
    border-radius: 0.9em;
    overflow: hidden;
  }

  .bw-tabs {
    display: flex;
    gap: 0.15em;
    padding: 0.6em 0.6em 0;
    background: var(--b-chrome);
    overflow: hidden;
  }

  .bw-tab {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.45em 0.4em;
    font-size: 0.72em;
    white-space: nowrap;
    overflow: hidden;
    color: var(--b-dim);
    border-radius: 0.5em 0.5em 0 0;
    mask-image: linear-gradient(90deg, #000 70%, transparent);
  }

  .bw-tab i {
    flex: none;
    width: 0.9em;
    height: 0.9em;
    border-radius: 0.2em;
    background: #8a8fa0;
  }

  .bw-tab:nth-child(3n) i {
    background: #c9a227;
  }

  .bw-tab:nth-child(4n + 1) i {
    background: #3a7bd5;
  }

  .bw-tab.on {
    color: var(--b-tx);
    background: var(--b-bg);
    mask-image: none;
  }

  .bw-bar {
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.5em 0.8em;
    border-bottom: 1px solid var(--b-line);
  }

  .bw-nav {
    color: var(--b-dim);
    letter-spacing: 0.3em;
  }

  .bw-bar :global(.bw-reload) {
    color: var(--b-dim);
  }

  .bw-url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0.35em 0.8em;
    font-size: 0.85em;
    color: var(--b-dim);
    background: #efece6;
    border-radius: 999px;
  }

  .bw-mail {
    position: relative;
    display: flex;
    color: var(--b-dim);
  }

  .bw-mail b {
    position: absolute;
    top: -0.7em;
    right: -1.1em;
    padding: 0.05em 0.4em;
    font-size: 0.72em;
    color: #fff;
    background: #c3321a;
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }

  .bw-page {
    position: relative;
    display: grid;
    grid-template-columns: 3.2em minmax(0, 1fr);
    height: 32.2em;
  }

  .bw-rail {
    display: grid;
    align-content: start;
    gap: 0.9em;
    padding: 1em 0.8em;
    background: #f0ede7;
    border-right: 1px solid var(--b-line);
  }

  .bw-rail i {
    height: 1.5em;
    border-radius: 0.3em;
    background: #d9d4ca;
  }

  .bw-main {
    padding: 1.2em 1.6em;
  }

  .bw-crumbs {
    display: flex;
    gap: 0.5em;
  }

  .bw-crumbs i {
    width: 5em;
    height: 0.6em;
    border-radius: 0.3em;
    background: #e2ddd3;
  }

  .bw-title {
    margin: 0.8em 0 0.6em;
    font-size: 1.35em;
    font-weight: 600;
  }

  .bw-tabsrow {
    display: flex;
    gap: 1.4em;
    font-size: 0.85em;
    color: var(--b-dim);
    border-bottom: 1px solid var(--b-line);
  }

  .bw-tabsrow span {
    padding: 0.5em 0;
  }

  .bw-tabsrow .on {
    color: var(--b-tx);
    box-shadow: inset 0 -2px #3a7bd5;
  }

  .bw-load {
    display: flex;
    align-items: center;
    gap: 0.8em;
    margin: 2.4em 0 1.6em;
    font-size: 0.95em;
    color: var(--b-dim);
  }

  .bw-spin {
    width: 1.8em;
    height: 1.8em;
    border: 0.22em solid #d9d4ca;
    border-top-color: #3a7bd5;
    border-radius: 50%;
  }

  .bw-skel {
    display: grid;
    gap: 0.8em;
  }

  .bw-skel i {
    width: var(--w);
    height: 0.8em;
    border-radius: 0.3em;
    background: linear-gradient(90deg, #ebe7df 30%, #f6f3ee 50%, #ebe7df 70%) 0 0 / 300% 100%;
  }

  .bw-inbox,
  .bw-signin {
    position: absolute;
    z-index: 2;
    background: #fff;
    border: 1px solid var(--b-line);
    border-radius: 0.6em;
    box-shadow: 0 1em 2.5em -1em rgb(40 30 20 / 0.4);
    opacity: 0;
    transform: translateY(0.8em);
    transition:
      opacity 0.3s,
      transform 0.35s var(--ease);
  }

  .bw-inbox {
    left: 18%;
    right: 6%;
    top: 1.2em;
    padding: 0.8em 0;
  }

  .bw-inbox-h {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0 0 0.4em;
    padding: 0 1em;
    font-weight: 600;
  }

  .bw-inbox-h b {
    margin-left: auto;
    color: #c3321a;
    font-size: 0.85em;
  }

  .bw-mailrow {
    margin: 0;
    padding: 0.45em 1em;
    font-size: 0.82em;
    border-top: 1px solid #eee9e0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bw-mailrow:nth-child(-n + 4) {
    font-weight: 600;
  }

  .bw-signin {
    left: 30%;
    right: 30%;
    top: 5em;
    display: grid;
    gap: 0.7em;
    padding: 1.2em;
  }

  .bw-signin p {
    margin: 0;
    font-weight: 600;
  }

  .bw-signin i {
    height: 2.2em;
    border-radius: 0.4em;
    background: #f0ede7;
  }

  [data-race][data-web='mail'] .bw-inbox,
  [data-race][data-web='signin'] .bw-signin {
    opacity: 1;
    transform: none;
  }

  [data-race][data-web='tabs'] .bw-tab {
    animation: v3-tabflick 1.1s steps(1) both;
    animation-delay: calc(var(--i) * 70ms);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bw-spin {
      animation: v3-spin 0.9s linear infinite;
    }

    .bw-skel i {
      animation: v3-shimmer 1.6s linear infinite;
    }

    [data-race][data-web='reload'] :global(.bw-reload) {
      animation: v3-spin 0.7s linear infinite;
    }

    [data-race][data-web='reload'] .bw-main {
      animation: v3-blank 1.4s ease both;
    }
  }

  @keyframes v3-tabflick {
    0% {
      background: var(--b-bg);
      color: var(--b-tx);
    }
    9% {
      background: transparent;
      color: var(--b-dim);
    }
  }

  @keyframes v3-shimmer {
    to {
      background-position: -300% 0;
    }
  }

  @keyframes v3-blank {
    0%,
    40% {
      opacity: 0.1;
    }
  }

  /* ---------- adoken lane ---------- */

  .race-win {
    font-size: clamp(6px, calc(100cqw / 52), 13px);
  }

  .race-app {
    grid-template-columns: minmax(0, 1fr);
    --app-h: 34.4em;
  }

  .race-app :global(.tree),
  .race-app :global(.pr-tabs .since) {
    display: none;
  }

  .race-app :global(.pr-body) {
    grid-template-columns: minmax(0, 1fr);
  }

  .race-app :global(.view) {
    padding: 1.3em 1.4em;
  }

  .lane-photo :global(.race-stamp) {
    position: absolute;
    z-index: 6;
    right: -1.2rem;
    bottom: -2rem;
    width: clamp(7rem, 13vw, 11rem);
    rotate: -12deg;
    opacity: 0;
    transform: scale(2.6);
    transition:
      opacity 0.12s,
      transform 0.32s cubic-bezier(0.25, 1.7, 0.45, 1);
    filter: drop-shadow(0 2px 0 rgb(120 20 5 / 0.15));
  }

  .race.done .lane-photo :global(.race-stamp) {
    opacity: 0.95;
    transform: none;
  }

  .race-foot {
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin-top: clamp(3rem, 5vw, 4.5rem);
    text-align: center;
  }

  .race-verdict {
    margin: 0;
    max-width: 24em;
    font: italic 400 clamp(1.5rem, 2.6vw, 2.2rem) / 1.2 var(--serif);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .race-note {
    margin: 0;
    text-align: center;
  }

  @media (max-width: 900px) {
    .race-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .race-track {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .race-vs {
      height: 2.6rem;
    }

    .race-vs::before {
      inset: 50% 0 auto;
      width: auto;
      height: 1px;
    }

    .lane-photo :global(.race-stamp) {
      right: -0.3rem;
    }
  }
</style>
